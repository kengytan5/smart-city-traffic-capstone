<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="abc.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1279"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="Metro_Interstate_Traffic_Volume" custom_title="0" dock_id="1" table="4,31:mainMetro_Interstate_Traffic_Volume"/><dock_state state="000000ff00000000fd000000010000000200000481000002dafc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000000004810000011900ffffff000004810000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="Metro_Interstate_Traffic_Volume" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="101"/><column index="2" value="54"/><column index="3" value="62"/><column index="4" value="62"/><column index="5" value="85"/><column index="6" value="101"/><column index="7" value="257"/><column index="8" value="156"/><column index="9" value="117"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="1.1">-- Check total row count
SELECT
	count(*)
FROM
	Metro_Interstate_Traffic_Volume</sql><sql name="1.11">-- Preview the first 5 records to verify columns mapped correctly
SELECT
	*
FROM
	Metro_Interstate_Traffic_Volume
LIMIT
	5;</sql><sql name="1.12">-- Rename the first row as the header accordingly and then delete away the first row
ALTER TABLE Metro_Interstate_Traffic_Volume RENAME COLUMN field1 TO holiday;
ALTER TABLE Metro_Interstate_Traffic_Volume RENAME COLUMN field2 TO temp;
ALTER TABLE Metro_Interstate_Traffic_Volume RENAME COLUMN field3 TO rain_1h;
ALTER TABLE Metro_Interstate_Traffic_Volume RENAME COLUMN field4 TO snow_1h;
ALTER TABLE Metro_Interstate_Traffic_Volume RENAME COLUMN field5 TO clouds_all;
ALTER TABLE Metro_Interstate_Traffic_Volume RENAME COLUMN field6 TO weather_main;
ALTER TABLE Metro_Interstate_Traffic_Volume RENAME COLUMN field7 TO weather_description;
ALTER TABLE Metro_Interstate_Traffic_Volume RENAME COLUMN field8 TO date_time;
ALTER TABLE Metro_Interstate_Traffic_Volume RENAME COLUMN field9 TO traffic_volume;

DELETE FROM Metro_Interstate_Traffic_Volume 
WHERE date_time = 'date_time';

SELECT
	*
FROM
	Metro_Interstate_Traffic_Volume
LIMIT
	5;</sql><sql name="1.2">SELECT 
    strftime('%Y', date_time) AS year, 
    SUM(traffic_volume) AS total_traffic_volume 
FROM 
    Metro_Interstate_Traffic_Volume 
WHERE 
    strftime('%Y', date_time) BETWEEN '2012' AND '2017' 
GROUP BY 
    year 
ORDER BY 
    year;</sql><sql name="1.21">-- Calculate the change between years where appropriate
WITH YearlyTraffic AS (
    SELECT 
        CAST(strftime('%Y', date_time) AS INT) AS year,
        SUM(traffic_volume) AS total_volume
FROM 
	Metro_Interstate_Traffic_Volume
WHERE 
	strftime('%Y', date_time) BETWEEN '2012' AND '2017'
GROUP BY 
	year
)
SELECT 
    year,
    total_volume,
    total_volume - LAG(total_volume) OVER (ORDER BY year) AS absolute_change,
    ROUND(
        ((total_volume - LAG(total_volume) OVER (ORDER BY year)) * 100.0) / 
        LAG(total_volume) OVER (ORDER BY year), 2
    ) AS percentage_change
FROM YearlyTraffic;</sql><sql name="1.3">-- Need to convert Kelvin to Degree C and compare for New Year's Day
SELECT 
    strftime('%Y', date_time) AS year,
    ROUND(AVG(temp) - 273.15, 2) AS avg_temp_celsius,
    ROUND(AVG(traffic_volume), 0) AS avg_traffic_volume
FROM 
	Metro_Interstate_Traffic_Volume
WHERE 
	(holiday = 'New Year''s Day' OR (strftime('%m-%d', date_time) = '01-01'))
  AND strftime('%Y', date_time) BETWEEN '2015' AND '2017'
  AND temp &gt; 0 -- Excludes unphysical 0 Kelvin anomalies found in this dataset
GROUP BY 
	year
ORDER BY 
	year;</sql><sql name="1.31">-- Need to convert Kelvin to Degree C and compare for Labor Day
SELECT 
    strftime('%Y', date_time) AS year,
    strftime('%Y-%m-%d', date_time) AS exact_date,
    ROUND(AVG(temp) - 273.15, 2) AS avg_temp_celsius,
    ROUND(AVG(traffic_volume), 0) AS avg_traffic_volume
FROM 
	Metro_Interstate_Traffic_Volume
WHERE 
	holiday = 'Labor Day'
  AND strftime('%Y', date_time) BETWEEN '2015' AND '2017'
GROUP BY 
	year, exact_date
ORDER BY 
	year;</sql><sql name="2.1">WITH OrderedTraffic AS (
    -- Subquery to rank traffic volume for Median calculation
    SELECT 
        CAST(traffic_volume AS INT) AS traffic_volume,
        ROW_NUMBER() OVER (ORDER BY CAST(traffic_volume AS INT)) AS row_num,
        COUNT(*) OVER () AS total_rows
    FROM 
		Metro_Interstate_Traffic_Volume
),
DescriptiveStats AS (
    SELECT 
        ROUND(AVG(CAST(traffic_volume AS INT)), 2) AS Mean,
        MAX(CAST(traffic_volume AS INT)) - MIN(CAST(traffic_volume AS INT)) AS Range,
        MIN(CAST(traffic_volume AS INT)) AS Min_Value,
        MAX(CAST(traffic_volume AS INT)) AS Max_Value
    FROM 
		Metro_Interstate_Traffic_Volume
),
MedianCalc AS (
    SELECT AVG(traffic_volume) AS Median
    FROM OrderedTraffic
    WHERE row_num IN ((total_rows + 1) / 2, (total_rows + 2) / 2)
),
VarianceCalc AS (
    -- Emulating Variance: AVG((x - mean)^2)
    SELECT 
        ROUND(AVG((CAST(traffic_volume AS INT) - (SELECT Mean FROM DescriptiveStats)) * 
                  (CAST(traffic_volume AS INT) - (SELECT Mean FROM DescriptiveStats))), 2) AS Variance
    FROM
		Metro_Interstate_Traffic_Volume
)
SELECT 
    d.Mean,
    m.Median,
    v.Variance,
    ROUND(SQRT(v.Variance), 2) AS Standard_Deviation,
    d.Range,
    d.Min_Value,
    d.Max_Value
FROM 
	DescriptiveStats d
CROSS JOIN 
	MedianCalc m
CROSS JOIN 
	VarianceCalc v;</sql><sql name="2.2">WITH CleanedData AS (
    SELECT 
        CAST(temp AS REAL) AS x, -- Temperature
        CAST(traffic_volume AS REAL) AS y -- Traffic Volume
    FROM 
		Metro_Interstate_Traffic_Volume
    WHERE CAST(temp AS REAL) &gt; 0 -- Filters out 0 Kelvin sensor anomalies
)
SELECT 
    COUNT(*) AS Total_Records,
    ROUND(
        (COUNT(*) * SUM(x * y) - SUM(x) * SUM(y)) / 
        (
            SQRT(COUNT(*) * SUM(x * x) - SUM(x) * SUM(x)) * 
            SQRT(COUNT(*) * SUM(y * y) - SUM(y) * SUM(y))
        ), 4
    ) AS Correlation_Coefficient
FROM CleanedData;</sql><sql name="3.0">WITH BaseData AS (
    SELECT 
        CASE WHEN CAST(traffic_volume AS INT) &gt; 5500 THEN 1 ELSE 0 END AS is_congested,
        CASE WHEN weather_main = 'Clear' THEN 1 ELSE 0 END AS is_clear,
        CASE WHEN weather_main = 'Clouds' THEN 1 ELSE 0 END AS is_cloudy,
        CASE WHEN CAST(temp AS REAL) &gt; 292.0 THEN 1 ELSE 0 END AS is_high_temp
    FROM 
		Metro_Interstate_Traffic_Volume
    WHERE CAST(temp AS REAL) &gt; 0 -- Filter out sensor anomalies
),
Totals AS (
    SELECT 
        COUNT(*) * 1.0 AS N,
        SUM(is_congested) * 1.0 AS n_congestion,
        SUM(is_clear) * 1.0 AS n_clear,
        SUM(is_cloudy) * 1.0 AS n_cloudy,
        SUM(CASE WHEN is_congested = 1 AND is_clear = 1 THEN 1 ELSE 0 END) * 1.0 AS n_cong_and_clear,
        SUM(CASE WHEN is_congested = 1 AND is_high_temp = 1 THEN 1 ELSE 0 END) * 1.0 AS n_cong_and_high_temp,
        SUM(CASE WHEN is_congested = 1 AND is_cloudy = 1 THEN 1 ELSE 0 END) * 1.0 AS n_cong_and_cloudy
    FROM BaseData
)
SELECT
    -- 3.1 Basic Probabilities
    ROUND(n_congestion / N, 4) AS P_Congestion,
    ROUND(n_clear / N, 4) AS P_Clear_Weather,
    ROUND(n_cong_and_clear / N, 4) AS P_Congestion_AND_Clear_Weather,
    
    -- 3.2 Conditional Probabilities
    ROUND(n_cong_and_clear / n_congestion, 4) AS P_Clear_Given_Congestion,
    ROUND(n_cong_and_high_temp / n_congestion, 4) AS P_High_Temp_Given_Congestion,
    
    -- Independent check values: P(Congestion) * P(Clear)
    ROUND((n_congestion / N) * (n_clear / N), 4) AS Independent_Check_Product,
    
    -- Odds Ratio Components
    ROUND(
        ((n_cong_and_clear) / (n_clear - n_cong_and_clear)) / 
        ((n_cong_and_cloudy) / (n_cloudy - n_cong_and_cloudy)), 4
    ) AS Odds_Ratio_Clear_vs_Cloudy
FROM Totals;</sql><current_tab id="9"/></tab_sql></sqlb_project>
